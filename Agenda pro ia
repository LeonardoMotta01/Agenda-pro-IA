name: Gerar APK
on: [push]
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: 'zulu'
          java-version: '17'
      - uses: subosito/flutter-action@v2
        with:
          channel: 'stable'
      - name: Build
        run: |
          ls -la
          find. -name "pubspec.yaml"
          DIR=$(dirname $(find. -name "pubspec.yaml" | head -n 1))
          echo "Indo para $DIR"
          cd $DIR
          flutter pub get
          flutter build apk --release
      - uses: actions/upload-artifact@v4
        with:
          name: apk-pronto
          path: "**/app-release.apk"
