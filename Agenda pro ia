name: Gerar APK
on: [push]
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: 'zulu'
          java-version: '17'
      - uses: subosito/flutter-action@v2
        with:
          channel: 'stable'
      - run: cd agenda_pro_ia && flutter pub get
      - run: cd agenda_pro_ia && flutter build apk --release
      - uses: actions/upload-artifact@v4
        with:
          name: app-release
          path: agenda_pro_ia/build/app/outputs/flutter-apk/app-release.apk
